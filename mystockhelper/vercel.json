{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/vercel-cron/opening-report",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/vercel-cron/opening-report",
      "schedule": "0 15 * * 1-5"
    }
  ]
}
